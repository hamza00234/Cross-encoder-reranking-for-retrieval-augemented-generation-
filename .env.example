# Copy this file to .env and fill in values.
#   cp .env.example .env
# Never commit .env — it is gitignored.

# Required for OpenRouter generation and the RAGAS judge.
OPENROUTER_API_KEY=

# Optional. Used if you point generation.backend at openai, or as a fallback key.
OPENAI_API_KEY=

# Optional. Hugging Face token for gated models or datasets.
HF_TOKEN=

# Optional. Overrides generation.ollama_base_url when backend is ollama.
OLLAMA_BASE_URL=http://localhost:11434
